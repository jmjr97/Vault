// ======================================================================
// Config: Fastfetch
// File: ~/.config/fastfetch/config.jsonc
// Platform: shared
// Link: https://github.com/fastfetch-cli/fastfetch
// ======================================================================

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    {
        "type": "host",
        "format": "{/2}{-}{/}{2}{?3} {3}{?}"
    },
    "kernel",
    "uptime",
    {
        "type": "battery",
        "format": "{/4}{-}{/}{4}{?5} [{5}]{?}"
    },
    "wm",
    "theme",
    "break",
    "packages",
    "shell",
    "terminal",
    "editor",
    "break",
    "cpu",
    {
        "type": "gpu",
        "key": "GPU"
    },
    "memory",
    "disk",
    "break",
    // "colors"
  ]
}
