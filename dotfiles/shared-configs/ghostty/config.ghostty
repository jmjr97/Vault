gtk-single-instance = false

theme = "Catppuccin Mocha"
foreground = #a9b1d6
background = #1a1b26
background-opacity = 0.7
background-blur = true

split-inherit-working-directory = true
bell-features = system
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell, notify

font-family = "FiraCode Nerd Font"
font-size = 14

window-height = 36
window-width = 118

keybind = ctrl+;>r=reload_config
keybind = ctrl+;>;=toggle_command_palette

# splits
keybind = ctrl+;>s=new_split:right
keybind = ctrl+;>d=new_split:down
keybind = ctrl+;>f=toggle_split_zoom

# split nav
keybind = ctrl+up=goto_split:up
keybind = ctrl+down=goto_split:down
keybind = ctrl+left=goto_split:left
keybind = ctrl+right=goto_split:right

# split resize
keybind = ctrl+alt+k=resize_split:up,50
keybind = ctrl+alt+j=resize_split:down,50
keybind = ctrl+alt+h=resize_split:left,50
keybind = ctrl+alt+l=resize_split:right,50
keybind = ctrl+;>'=equalize_splits

# tabs
keybind = ctrl+;>t=new_tab
keybind = ctrl+;>o=toggle_tab_overview
keybind = ctrl+;>q>q=close_tab
keybind = ctrl+;>w=previous_tab
keybind = ctrl+;>e=next_tab

keybind = ctrl+;>c=copy_to_clipboard
keybind = ctrl+;>v=paste_from_clipboard

keybind = ctrl+enter=ignore
