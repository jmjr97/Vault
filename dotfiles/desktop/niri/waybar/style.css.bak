* {
  /* font-family: Firacode Nerd Font Propo, Helvetica, Arial, sans-serif; */
	font-family: "JetBrainsMono Nerd Font Propo";
  font-size: 16px;
}

window#waybar {
	background: transparent;
}

tooltip {
  background: #1e1e2e;
  border: 1px solid #8aadf4;
  border-radius: 5px;
}

tooltip label {
  color: #cad3f5;
}

#workspaces {
	background: #24273a;
  color: #8aadf4;
	border: 1px solid #494d64;
  border-radius: 8px;
	margin-top: 4px;
}

#workspaces button {
	transition: all 200ms ease-in-out;
  color: #8aadf4;
  padding: 0 8px;
  border-radius: 6px;
	min-width: 20px;
}

#workspaces button label {
  font-size: 20px;
}

#workspaces button.active {
	min-width: 40px;
  background: #8aadf4;
	color: #24273a;
}

#clock {
	background: #24273a;
	color: #8aadf4;
	border: 1px solid #494d64;
	border-radius: 8;
	padding: 0 10px;
	margin-top: 4px;
	margin-left: 10px;
}

/* main screen */

#launchers {
	background: #24273a;
	color: #8aadf4;
	border: 1px solid #494d64;
	border-radius: 8;
	font-weight: bold;
	padding: 0 10px;
	margin-top: 4px;
}

#custom-web {	
	padding: 0 10px;
}

#custom-max,
#bluetooth,
#pulseaudio,
#idle_inhibitor,
#custom-notify {
	background: #24273a;
	color: #8aadf4;
	border: 1px solid #494d64;
	border-radius: 8;
	padding: 0 10px;
	margin-top: 4px;
}

#keyboard-state label.locked {
	background: #24273a;
	color: #ed8796;
	border: 1px solid #494d64;
	border-radius: 8;
	padding: 0 10px;
	margin-top: 4px;
}

#pulseaudio.muted {
	color: #ed8796;
}

#idle_inhibitor.activated {
	color: #ed8796;
}

#custom-power {
	background: #24273a;
	color: #8aadf4;
	border: 1px solid #494d64;
	border-radius: 8;
	font-weight: bold;
	padding: 0 10px;
	margin-right: 10px;
	margin-top: 4px;
}

#custom-files:hover,
#custom-web:hover,
#custom-obsidian:hover,
#custom-max:hover,
#pulseaudio:hover,
#bluetooth:hover,
#idle_inhibitor:hover,
#idle_inhibitor.activated:hover,
#custom-notify:hover,
#custom-power:hover {
	color: #cad3f5;
}

/* right screen */

#tray {
	background: #24273a;
	color: #ffffff;
	border: 1px solid #494d64;
	border-radius: 8;
	padding: 0 10px;
	margin-top: 4px;
}

#custom-pacman,
#temperature,
#custom-gpu,
#cpu,
#memory {
	background: #24273a;
	color: #f5a97f;
	border: 1px solid #494d64;
	border-radius: 8;
	padding: 0 10px;
	margin-top: 4px;
}

#custom-weather {
	background: #24273a;
	color: #f5a97f;
	border: 1px solid #494d64;
	border-radius: 8;
	padding: 0 10px;
	margin-top: 4px;
}

#storage {
	background: #24273a;
	color: #f5a97f;
	border: 1px solid #494d64;
	border-radius: 8;
	padding: 0 10px;
	margin-right: 10px;
	margin-top: 4px;
}

#disk.games {
	padding: 0 10px;
}

#network {
	background: #24273a;
	color: #ed8796;
	border: 1px solid #494d64;
	border-radius: 8;
	padding: 0 10px;
	margin-top: 4px;
}

